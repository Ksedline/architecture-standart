@startuml C4_Context.puml
!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Context.puml

Person(visitor, "Посетитель сайта")
Person(client, "Клиент интернет-банка")
Person_Ext(cc_agent, "Оператор кол-центра")
Person(fo_dep, "Фронт-офис")
Person(bo_dep, "Бэк-офис депозитов")
Person(bo_cred, "Бэк-офис кредитов")

System_Ext(sms, "SMS-Gateway", "HTTP API телеком-оператора")

System_Boundary(bank, "Банк «Стандарт»") {
  System(internet_bank, "Internet Bank", "ASP.NET MVC 4.5 / MS SQL")
  System(site, "Public Web-Site", "PHP + React")
  System_Ext(crm, "CRM Call-Centre", "React / Spring Boot / PostgreSQL")
  System(deposit_api, "Deposit API Service", "REST /.NET 8")
  System(abs, "ABS", "Delphi + Oracle DB")
}

Rel(visitor, site, "Просмотр ставок, заявка (UC-1)", "HTTPS")
Rel(site, crm, "Create Lead", "REST/HTTPS")
Rel(cc_agent, crm, "Обработка лида / ставка")

Rel(crm, deposit_api, "POST /lead → согласование", "REST")

Rel_L(client, internet_bank, "Открыть депозит (UC-2)", "HTTPS")
Rel_D(internet_bank, deposit_api, "Запрос ставки депозита")

Rel(deposit_api, abs, "PL/SQL / DB Link")

Rel_U(bo_dep, abs, "Подтверждение ставки")

Rel_U(bo_cred, abs, "Предоставление кредитной истории")

Rel_U(fo_dep, abs, "Внесение информации о договоре в систему / корректировка информации о клиенте (UC-3)")

Rel_U(fo_dep, client, "Взаимодействие с клиентом")

Rel_L(abs, sms, "Уведомление SMS", "HTTP")
Rel_L(crm, sms, "Уведомление SMS", "HTTP")
Rel_U(sms, client, "Направление кода подтверждения", "REST")

@enduml